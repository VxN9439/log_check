{
  "name": "log-check-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:standalone": "npm run build && node scripts/build-standalone.mjs",
    "build:web": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "electron": "npm run build && electron .",
    "dist:portable": "npm run build && electron-builder --win portable --config.directories.output=portable-final"
  },
  "build": {
    "appId": "com.logcheck.app",
    "productName": "Log Check",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ],
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "vite": "^5.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1"
  }
}
